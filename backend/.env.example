PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-prep
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional Gemini API credentials for follow-up questions and scored feedback.
# Without a key, follow-ups use a conservative local heuristic and feedback is
# saved as unscored; no estimated scores are generated.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional override for self-hosted compatible endpoints. Do not put the key in this URL.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
